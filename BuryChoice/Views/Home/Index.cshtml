                        <div id="map" style="height:100%;width:100%;"></div>
                    </figure>
                    <p class="p-3">CAVEAT: Addresses taken from Get Information About Schools (GIAS), in the form of Easting/Northing and translated into Longitude and Latitude. Bury Council use their own proprietory LLPG to hold addresses. The locations of the schools match the LLPG. </p>
                </div>

            </div>
        </div>
        <div class="column">
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            Name
                        </th>
                        <th>
                            Admitted/ PAN  (2026)
                        </th>
                        <th>
                            Admitted/ PAN (2025)
                        </th>
                        <th>
                            Admitted/ PAN (2024)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OfferDetails)
                    {
                        <tr>
                            <th> @item.Name </th>
                            <td> @item.Total26 / @item.PAN26 </td>
                            <td> @item.Total25 / @item.PAN25 </td>
                            <td> @item.Total24 / @item.PAN24 </td>
                        </tr>
                    }
                    <tr>
                        <th>Number of Year 6 students in Bury</th>
                        <td>2,329</td>
                        <td>2,382</td>
                        <td>2,396</td>

                    </tr>
                    <tr>
