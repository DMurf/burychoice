                                {
                                    <text>@item.Distance26?.ToString("0.##") miles</text>
                                }
                                else
                                {
                                    <text>N/A</text>
                                }
                            </td>
                            <td>
                                @if (item.Distance25.HasValue)
                                {
                                    <text>@item.Distance25?.ToString("0.##") miles</text>
                                }
                                else
                                {
                                    <text>N/A</text>
                                }
                            </td>
                            <td>
                                @if (item.Distance24.HasValue)
                                {
                                    <text>@item.Distance24?.ToString("0.##") miles</text>
                                }
                                else
                                {
                                    <text>N/A</text>
                                }
                            </td>
                        </tr>
                    }
