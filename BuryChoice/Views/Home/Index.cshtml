<script src='https://api.mapbox.com/mapbox.js/plugins/leaflet-fullscreen/v1.0.1/Leaflet.fullscreen.min.js'></script>
<link href='https://api.mapbox.com/mapbox.js/plugins/leaflet-fullscreen/v1.0.1/leaflet.fullscreen.css' rel='stylesheet' />
<script>
    const map = L.map('map', { fullscreenControl: true }).setView([53.608253, -2.338538], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

    const markersData = @Html.Raw(Model.LocationDataJson);
    console.log(markersData);
    // create markers and keep original data on each marker for reference
    const markers = markersData.map(d => {
        const m = L.marker([d.lat, d.lng], { title: d.title }).addTo(map).bindPopup(d.title);
        m._meta = d;
        return m;
    });

    const linesGroup = L.layerGroup().addTo(map);

    // Group for range circles (created from markersData). Not added to map by default.
    const rangesGroup = L.layerGroup();

    // Create circle(s) for markers that include a range value in their data.
    // Supported properties: furthestOffer, range, rangeMeters, maxRange (interpreted as diameter in meters).
    markers.forEach(m => {
        const d = m._meta || {};
        const rangeVal = d.furthestOffer;

        if (rangeVal != null && !isNaN(Number(rangeVal))) {
            const diameter = Number(rangeVal);
            const circle = L.circle(m.getLatLng(), {
                radius: formatDistanceReverse(d.furthestOffer),
                color: '#28a745',
                fillColor: '#28a745',
                fillOpacity: 0.08,
                interactive: false
            });
            // attach source marker reference for potential future use
            circle._sourceMarker = m;
            rangesGroup.addLayer(circle);
        }

    });

    // Always display distances in miles (convert from meters)
    function formatDistance(meters) {
        const miles = meters * 0.000621371; // 1 meter = 0.000621371 miles
        return miles.toFixed(2) + ' miles';
    }

    function formatDistanceReverse(miles) {
        const meters = (miles / 0.000621371); // 1 meter = 0.000621371 miles
        return meters;
    }

    // Add a small control to toggle range circles on/off
    const rangesControl = L.control({ position: 'topright' });
    rangesControl.onAdd = function(map) {
        const container = L.DomUtil.create('div', 'leaflet-bar leaflet-control');
        container.style.padding = '6px';
        container.style.background = 'white';
        container.style.boxShadow = '0 1px 4px rgba(0,0,0,0.2)';
        container.innerHTML = '<label style="display:flex;align-items:center;gap:6px;margin:0;white-space:nowrap;"><input id="toggleRanges" type="checkbox"> Show furthest offer in 2026</label>';
        L.DomEvent.disableClickPropagation(container);
        return container;
    };
    rangesControl.addTo(map);

    // Toggle behavior — attach handler to the checkbox created in the control.
    function attachRangesToggle() {
        const cb = document.getElementById('toggleRanges');
        if (!cb) return false;
        cb.addEventListener('change', function(e) {
            if (e.target.checked) {
                rangesGroup.addTo(map);
            } else {
                if (map.hasLayer(rangesGroup)) map.removeLayer(rangesGroup);
            }
        });
        // If there are any ranges available, enable and show them by default
        try {
            if (rangesGroup.getLayers().length > 0) {
                cb.checked = true;
                rangesGroup.addTo(map);
            }
        } catch (err) {
            console.debug('rangesGroup not ready', err);
        }
        return true;
    }

    // Try to attach immediately; if the control hasn't been added to DOM yet, retry briefly.
    if (!attachRangesToggle()) {
        let retries = 0;
        const retryInterval = setInterval(() => {
            if (attachRangesToggle() || ++retries > 10) clearInterval(retryInterval);
        }, 100);
    }

    map.on('click', function(e) {
        linesGroup.clearLayers(); const click = e.latlng;
        // compute distances
        const results = markers.map(m => {
            return { marker: m, distance: click.distanceTo(m.getLatLng()) };
        }).sort((a, b) => a.distance - b.distance);

        // draw lines and labels; highlight nearest
        results.forEach((r, i) => {
            const opts = { color: i === 0 ? '#d9534f' : '#007bff', weight: i === 0 ? 3 : 1, dashArray: '6,6' };
            L.polyline([click, r.marker.getLatLng()], opts).addTo(linesGroup);
        });

        // popup with sorted list
        const listHtml = results.map((r, idx) => {
            const title = r.marker.options.title || ('Marker ' + (idx + 1));
            return `${idx + 1}. ${title}: <b>${formatDistance(r.distance)}</b>`;
        }).join('<br/>');

        L.popup({ maxWidth: 300 })
            .setLatLng(click)
            .setContent('<strong>Distances to markers</strong><br/>' + listHtml)
            .openOn(map);
    });
</script>
